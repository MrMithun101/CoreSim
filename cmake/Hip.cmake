option(CORESIM_ENABLE_HIP "Build AMD HIP vector-add backend (Linux ROCm)" OFF)
option(CORESIM_HIP_DEVICE_TESTS "Run tests requiring a compatible AMD GPU" OFF)
if(CORESIM_HIP_DEVICE_TESTS AND NOT CORESIM_ENABLE_HIP)
    message(FATAL_ERROR "CORESIM_HIP_DEVICE_TESTS requires CORESIM_ENABLE_HIP")
endif()
if(CORESIM_ENABLE_HIP)
    if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
        message(FATAL_ERROR "CoreSim HIP currently requires Linux with AMD ROCm")
    endif()
    if(NOT CORESIM_SANITIZER STREQUAL "none")
        message(FATAL_ERROR "HIP builds do not support CoreSim host sanitizer flags; use a separate CPU build")
    endif()
    include(CheckLanguage)
    check_language(HIP)
    if(NOT CMAKE_HIP_COMPILER)
        message(FATAL_ERROR "HIP compiler unavailable: set CMAKE_HIP_COMPILER to ROCm llvm/bin/clang++")
    endif()
    enable_language(HIP)
    set(CMAKE_HIP_STANDARD 20)
    set(CMAKE_HIP_STANDARD_REQUIRED ON)
    set(CMAKE_HIP_EXTENSIONS OFF)
    find_package(hip CONFIG REQUIRED)
endif()
add_library(coresim_gpu src/gpu/VectorAdd.cpp src/gpu/Demo.cpp)
target_include_directories(coresim_gpu PUBLIC include)
if(CORESIM_ENABLE_HIP)
    target_sources(coresim_gpu PRIVATE src/gpu/VectorAdd.hip)
    set_source_files_properties(src/gpu/VectorAdd.hip PROPERTIES LANGUAGE HIP)
    target_link_libraries(coresim_gpu PUBLIC hip::host)
else()
    target_sources(coresim_gpu PRIVATE src/gpu/HipUnavailable.cpp)
endif()
coresim_target_options(coresim_gpu)
add_executable(coresim_gpu_demo src/gpu/main.cpp)
target_link_libraries(coresim_gpu_demo PRIVATE coresim_gpu)
coresim_target_options(coresim_gpu_demo)
if(BUILD_TESTING)
    add_executable(coresim_gpu_tests tests/GpuTests.cpp)
    target_link_libraries(coresim_gpu_tests PRIVATE coresim_gpu Catch2::Catch2WithMain)
    coresim_target_options(coresim_gpu_tests)
    if(CORESIM_ENABLE_HIP)
        target_compile_definitions(coresim_gpu_tests PRIVATE CORESIM_TEST_HIP_COMPILED)
        # Always compile/link the hardware suite, but only run it when explicitly requested.
        add_executable(coresim_hip_device_tests tests/HipDeviceTests.cpp)
        target_link_libraries(coresim_hip_device_tests PRIVATE coresim_gpu Catch2::Catch2WithMain)
        coresim_target_options(coresim_hip_device_tests)
        if(CORESIM_HIP_DEVICE_TESTS)
            add_test(NAME coresim.hip_device COMMAND coresim_hip_device_tests)
            set_tests_properties(coresim.hip_device PROPERTIES LABELS gpu TIMEOUT 120)
        endif()
    endif()
    add_test(NAME coresim.gpu_cpu COMMAND coresim_gpu_tests)
    add_test(NAME coresim.gpu_demo_cpu COMMAND coresim_gpu_demo --elements 1025)
    add_test(NAME coresim.gpu_info COMMAND coresim_gpu_demo --info)
    set_tests_properties(coresim.gpu_demo_cpu PROPERTIES PASS_REGULAR_EXPRESSION "backend=cpu elements=1025 verified=true")
    foreach(bad_args "--elements;-1" "--elements;2x" "--backend;auto" "--elements;1;--elements;2")
        string(MAKE_C_IDENTIFIER "${bad_args}" bad_name)
        add_test(NAME coresim.gpu_invalid_${bad_name} COMMAND coresim_gpu_demo ${bad_args})
        set_tests_properties(coresim.gpu_invalid_${bad_name} PROPERTIES WILL_FAIL TRUE)
    endforeach()
    if(NOT CORESIM_ENABLE_HIP)
        add_test(NAME coresim.gpu_unavailable COMMAND coresim_gpu_demo --backend hip)
        set_tests_properties(coresim.gpu_unavailable PROPERTIES WILL_FAIL TRUE)
    endif()
endif()
