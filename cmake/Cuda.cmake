option(CORESIM_ENABLE_CUDA "Build the NVIDIA CUDA particle backend" OFF)
option(CORESIM_CUDA_DEVICE_TESTS "Run CUDA tests requiring real NVIDIA hardware" OFF)
if(CORESIM_CUDA_DEVICE_TESTS AND (NOT CORESIM_ENABLE_CUDA OR NOT BUILD_TESTING))
    message(FATAL_ERROR "CORESIM_CUDA_DEVICE_TESTS requires CORESIM_ENABLE_CUDA and BUILD_TESTING")
endif()
if(CORESIM_ENABLE_CUDA)
    if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux" OR NOT CORESIM_SANITIZER STREQUAL "none")
        message(FATAL_ERROR "CoreSim CUDA requires a separate unsanitized Linux build")
    endif()
    enable_language(CUDA)
    if(NOT CMAKE_CUDA_COMPILER_ID STREQUAL "NVIDIA" OR CMAKE_CUDA_COMPILER_VERSION VERSION_LESS 12)
        message(FATAL_ERROR "CoreSim CUDA requires NVIDIA NVCC 12+ with C++20 support")
    endif()
    find_package(CUDAToolkit REQUIRED)
    add_library(coresim_cuda_particles STATIC src/particles/CudaParticles.cu)
    target_include_directories(coresim_cuda_particles PRIVATE include)
    set_target_properties(coresim_cuda_particles PROPERTIES CUDA_STANDARD 20 CUDA_STANDARD_REQUIRED ON CUDA_EXTENSIONS OFF)
    target_compile_options(coresim_cuda_particles PRIVATE $<$<COMPILE_LANGUAGE:CUDA>:--fmad=false>)
    target_link_libraries(coresim_cuda_particles PUBLIC CUDA::cudart)
    target_link_libraries(coresim_particles PRIVATE coresim_cuda_particles)
else()
    target_sources(coresim_particles PRIVATE src/particles/CudaUnavailable.cpp)
endif()
