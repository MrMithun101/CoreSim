add_library(coresim_particles src/particles/CudaParticles.cpp src/particles/ParticleSimulation.cpp src/particles/ParticleRunner.cpp src/particles/SoASimulation.cpp src/particles/ParticleBenchmark.cpp)
target_include_directories(coresim_particles PUBLIC include)
target_link_libraries(coresim_particles PUBLIC coresim_jobs)
coresim_target_options(coresim_particles)
include(cmake/Cuda.cmake)
target_compile_definitions(coresim_particles PRIVATE
    CORESIM_BUILD_TYPE="$<CONFIG>"
    CORESIM_COMPILER="${CMAKE_CXX_COMPILER_ID}-${CMAKE_CXX_COMPILER_VERSION}"
    CORESIM_SANITIZER_NAME="${CORESIM_SANITIZER}"
    CORESIM_BUILD_OS="${CMAKE_SYSTEM_NAME}"
    CORESIM_BUILD_ARCH="${CMAKE_SYSTEM_PROCESSOR}")
add_executable(coresim_particle_benchmark src/particles/benchmark_main.cpp)
target_link_libraries(coresim_particle_benchmark PRIVATE coresim_particles)
coresim_target_options(coresim_particle_benchmark)
add_executable(coresim_particle_runner src/particles/main.cpp)
target_link_libraries(coresim_particle_runner PRIVATE coresim_particles)
coresim_target_options(coresim_particle_runner)
if(BUILD_TESTING)
    add_executable(coresim_particle_tests tests/ParticleTests.cpp)
    target_link_libraries(coresim_particle_tests PRIVATE coresim_particles Catch2::Catch2WithMain)
    coresim_target_options(coresim_particle_tests)
    add_test(NAME coresim.particles COMMAND coresim_particle_tests)
    set_tests_properties(coresim.particles PROPERTIES TIMEOUT 120 LABELS concurrency)
    foreach(count 1000 10000 100000)
        add_test(NAME coresim.particles_${count} COMMAND coresim_particle_runner --particles ${count} --steps 12 --workers 3)
        set_tests_properties(coresim.particles_${count} PROPERTIES PASS_REGULAR_EXPRESSION "cpu_parity=exact-every-tick" TIMEOUT 60)
    endforeach()
    foreach(backend serial parallel)
        add_test(NAME coresim.particles_${backend} COMMAND coresim_particle_runner --backend ${backend} --particles 1000 --steps 12)
    endforeach()
    foreach(bad_args "--particles;0" "--particles;100001" "--steps;2x" "--workers;0" "--seed;4294967296" "--backend;unknown" "--steps;1;--steps;2")
        string(MAKE_C_IDENTIFIER "${bad_args}" bad_name)
        add_test(NAME coresim.particles_invalid_${bad_name} COMMAND coresim_particle_runner ${bad_args})
        set_tests_properties(coresim.particles_invalid_${bad_name} PROPERTIES WILL_FAIL TRUE)
    endforeach()
endif()
if(BUILD_TESTING)
    find_package(Python3 QUIET COMPONENTS Interpreter)
    if(Python3_Interpreter_FOUND)
        add_test(NAME coresim.particle_benchmark_exports COMMAND ${Python3_EXECUTABLE}
            ${PROJECT_SOURCE_DIR}/tests/ParticleExportTest.py $<TARGET_FILE:coresim_particle_benchmark>)
    endif()
endif()
if(BUILD_TESTING)
    target_sources(coresim_particle_tests PRIVATE tests/CudaParticleTests.cpp)
    add_test(NAME coresim.cuda_info COMMAND coresim_particle_runner --cuda-info)
    if(CORESIM_ENABLE_CUDA)
        target_compile_definitions(coresim_particle_tests PRIVATE CORESIM_TEST_CUDA)
        set_tests_properties(coresim.cuda_info PROPERTIES PASS_REGULAR_EXPRESSION "cuda_compiled=true")
        add_executable(coresim_cuda_device_tests tests/CudaDeviceTests.cpp)
        target_link_libraries(coresim_cuda_device_tests PRIVATE coresim_particles CUDA::cudart Catch2::Catch2WithMain)
        coresim_target_options(coresim_cuda_device_tests)
        if(CORESIM_CUDA_DEVICE_TESTS)
            add_test(NAME coresim.cuda_device COMMAND coresim_cuda_device_tests)
            add_test(NAME coresim.cuda_runner COMMAND coresim_particle_runner --backend cuda --particles 100000 --steps 120 --seed 7)
            set_tests_properties(coresim.cuda_device coresim.cuda_runner PROPERTIES LABELS cuda TIMEOUT 180)
        endif()
    else()
        set_tests_properties(coresim.cuda_info PROPERTIES PASS_REGULAR_EXPRESSION "cuda_compiled=false devices=0")
        add_test(NAME coresim.cuda_unavailable COMMAND coresim_particle_runner --backend cuda)
        set_tests_properties(coresim.cuda_unavailable PROPERTIES WILL_FAIL TRUE)
    endif()
endif()
add_executable(coresim_particle_profile src/particles/profile_main.cpp)
target_link_libraries(coresim_particle_profile PRIVATE coresim_particles)
target_compile_definitions(coresim_particle_profile PRIVATE
    CORESIM_BUILD_TYPE="$<CONFIG>" CORESIM_COMPILER="${CMAKE_CXX_COMPILER_ID}-${CMAKE_CXX_COMPILER_VERSION}"
    CORESIM_SANITIZER_NAME="${CORESIM_SANITIZER}")
coresim_target_options(coresim_particle_profile)
if(BUILD_TESTING)
    add_test(NAME coresim.particles_profile_cpu COMMAND coresim_particle_profile --backend parallel --workers 3 --particles 257 --steps 12 --warmup 2)
    set_tests_properties(coresim.particles_profile_cpu PROPERTIES PASS_REGULAR_EXPRESSION "verified\":true")
    if(CORESIM_CUDA_DEVICE_TESTS)
        add_test(NAME coresim.cuda_profile COMMAND coresim_particle_profile --backend cuda --particles 100000 --steps 120)
        set_tests_properties(coresim.cuda_profile PROPERTIES LABELS cuda TIMEOUT 180)
    endif()
endif()
if(BUILD_TESTING AND Python3_Interpreter_FOUND AND NOT CORESIM_CUDA_DEVICE_TESTS
   AND CMAKE_BUILD_TYPE STREQUAL "Release" AND CORESIM_SANITIZER STREQUAL "none")
    add_test(NAME coresim.particles_profile_rehearsal COMMAND ${Python3_EXECUTABLE}
        ${PROJECT_SOURCE_DIR}/tests/CudaStudyTest.py ${CMAKE_BINARY_DIR} ${CMAKE_CTEST_COMMAND})
endif()
